// dialect.nv — the eight decisions that separate one comma-separated
// file from another, in one value.
//
// RFC 4180 describes one file format and the world ships a dozen.  The
// difference between them is small.  A semicolon instead of a comma, a
// backslash instead of a doubled quote, a `#` line the producer thinks
// is a comment.  A reader that hard-codes the first reading grows flags
// until it has this struct anyway, spread over its call sites.  It is a
// value from the start, built once where a person can read it and
// passed to the reader and the writer both.
//
// A byte in a dialect is an `Int` and not a `Str`.  A delimiter is one
// byte.  Spelling it `","` invites `", "`, which is not a delimiter,
// and forces every comparison in the scanner through a string equality.
// As an `Int` it is the byte the scanner is already looking at, the
// constructors below spell the common ones by name, and a caller with
// an exotic separator writes `0x1F` and means it.  `-1` is the value
// that says there is no such byte, which is how a dialect turns a
// feature off.
//
// Validation is a separate call.  `with_delim` cannot refuse, because
// it returns a `Dialect`, and a builder that returned `?Dialect` would
// make every chained call an unwrap.  The builders are total, `check`
// is the one place that answers whether the combination makes sense,
// and the reader calls it once before it reads a byte.  A contradictory
// dialect is therefore reported at the file, with a reason, rather than
// parsed around.

// The largest byte value, and the sentinel one below the smallest.
// Spelled once so that `check`'s four range tests read as one rule.
const BYTE_MAX: Int = 255
const NO_BYTE: Int = -1

// One mebibyte, the default bound on a single field.  Big enough that
// no honest CSV file meets it, small enough that a file with one
// unclosed quote is refused after a megabyte rather than after the
// whole of itself.
const DEFAULT_MAX_FIELD: Int = 1048576

// How to read or write one comma-separated file.
//
// Build one from `rfc4180()` or `tsv()` and change what differs; the
// `with_*` calls each return a new value, so a dialect is a constant a
// module can share.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let semis = dialect.with_delim(dialect.rfc4180(), 0x3B)  // ';'
//     println("${semis.delim}")
// ```
pub struct Dialect
    // The byte between fields.  `0x2C` (`,`) in RFC 4180.
    delim: Int
    // The byte that opens and closes a quoted field.  `0x22` (`"`).
    quote: Int
    // The byte that escapes a quote inside a quoted field, or `-1` for
    // RFC 4180's doubling (`""`).  A file that uses `\"`, which is
    // most of the files a shell script produced, sets this to `0x5C`.
    escape: Int
    // A byte that, as the first byte of a line outside a quoted field,
    // makes the whole line a comment.  `-1` for none, which is RFC
    // 4180: the standard has no comments and neither does the default.
    comment: Int
    // Whether the first record is a header.  When true the reader
    // consumes it into `reader.header_row` rather than emitting it,
    // and the writer's `write_header` is what puts it back.
    has_header: Bool
    // Whether to drop leading and trailing spaces and tabs from an
    // unquoted field.  False by default, because RFC 4180 § 2.4 says
    // the space is part of the field, and a reader that silently
    // disagrees loses data nobody asked it to lose.
    trim: Bool
    // Whether to refuse what RFC 4180 forbids instead of reading it
    // the lenient way.  Under `strict` a bare quote in an unquoted
    // field is `BareQuote` and a record of the wrong width is
    // `RaggedRow`; otherwise the quote is data and the width varies.
    strict: Bool
    // The largest single field, in bytes, or `0` for unbounded.  This
    // is the bound that keeps one unclosed quote in a hostile file
    // from accumulating the whole file into one string before the
    // reader notices; `FieldTooLong` is what it reports.
    max_field: Int

// RFC 4180 as written: comma, double quote, doubled quotes, no
// comments, no trimming, a header row, lenient, fields bounded at
// 1 MiB.
//
// The two places this is not literally the RFC are the header and the
// field bound.  The RFC makes the header optional, and every consumer
// of this package has one.  The RFC does not mention a field bound,
// because it does not consider a hostile input.  Both are `with_*`
// calls away.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.rfc4180()
//     println("${d.delim} ${d.quote}")         // 44 34
// ```
pub fn rfc4180() -> Dialect
    Dialect { delim: 0x2C, quote: 0x22, escape: NO_BYTE, comment: NO_BYTE,
              has_header: true, trim: false, strict: false,
              max_field: DEFAULT_MAX_FIELD }

// Tab-separated, otherwise RFC 4180.  The delimiter is `0x09` and
// nothing else changes, which is what `csv.excel_tab` means in
// Python's `csv` and what `--delimiter=$'\t'` means to `csvkit`.
//
// It is not the IANA `text/tab-separated-values` format, which forbids
// quoting entirely and escapes tabs as `\t`.  A file in that
// format reads correctly here as long as no field contains a quote.
//
// ```novo
// use dialect
//
// fn main() [io]
//     println("${dialect.tsv().delim}")        // 9
// ```
pub fn tsv() -> Dialect
    with_delim(rfc4180(), 0x09)

// The same dialect with a different field separator.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.with_delim(dialect.rfc4180(), 0x7C)   // '|'
//     println("${d.delim}")                    // 124
// ```
pub fn with_delim(d: Dialect, byte: Int) -> Dialect
    Dialect { delim: byte, quote: d.quote, escape: d.escape,
              comment: d.comment, has_header: d.has_header, trim: d.trim,
              strict: d.strict, max_field: d.max_field }

// The same dialect with a different quote byte.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.with_quote(dialect.rfc4180(), 0x27)   // '\''
//     println("${d.quote}")                    // 39
// ```
pub fn with_quote(d: Dialect, byte: Int) -> Dialect
    Dialect { delim: d.delim, quote: byte, escape: d.escape,
              comment: d.comment, has_header: d.has_header, trim: d.trim,
              strict: d.strict, max_field: d.max_field }

// The same dialect with a backslash-style escape byte, or `-1` to go
// back to RFC 4180's doubled quotes.
//
// Setting an escape does not turn doubling off: a file that uses `\"`
// usually still writes `""` somewhere, and a reader that accepted only
// one of them would fail on the other half of the same file.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.with_escape(dialect.rfc4180(), 0x5C)  // '\\'
//     println("${d.escape}")                   // 92
// ```
pub fn with_escape(d: Dialect, byte: Int) -> Dialect
    Dialect { delim: d.delim, quote: d.quote, escape: byte,
              comment: d.comment, has_header: d.has_header, trim: d.trim,
              strict: d.strict, max_field: d.max_field }

// The same dialect with a comment byte, or `-1` for none.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.with_comment(dialect.rfc4180(), 0x23) // '#'
//     println("${d.comment}")                  // 35
// ```
pub fn with_comment(d: Dialect, byte: Int) -> Dialect
    Dialect { delim: d.delim, quote: d.quote, escape: d.escape,
              comment: byte, has_header: d.has_header, trim: d.trim,
              strict: d.strict, max_field: d.max_field }

// The same dialect, reading the first record as a header or not.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.with_header(dialect.rfc4180(), false)
//     println("${d.has_header}")               // false
// ```
pub fn with_header(d: Dialect, on: Bool) -> Dialect
    Dialect { delim: d.delim, quote: d.quote, escape: d.escape,
              comment: d.comment, has_header: on, trim: d.trim,
              strict: d.strict, max_field: d.max_field }

// The same dialect, trimming unquoted fields or not.
//
// ```novo
// use dialect
//
// fn main() [io]
//     println("${dialect.with_trim(dialect.rfc4180(), true).trim}")
// ```
pub fn with_trim(d: Dialect, on: Bool) -> Dialect
    Dialect { delim: d.delim, quote: d.quote, escape: d.escape,
              comment: d.comment, has_header: d.has_header, trim: on,
              strict: d.strict, max_field: d.max_field }

// The same dialect, refusing what RFC 4180 forbids or reading it
// leniently.
//
// ```novo
// use dialect
//
// fn main() [io]
//     println("${dialect.with_strict(dialect.rfc4180(), true).strict}")
// ```
pub fn with_strict(d: Dialect, on: Bool) -> Dialect
    Dialect { delim: d.delim, quote: d.quote, escape: d.escape,
              comment: d.comment, has_header: d.has_header, trim: d.trim,
              strict: on, max_field: d.max_field }

// The same dialect with a different single-field bound, or `0` for
// unbounded.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let d = dialect.with_max_field(dialect.rfc4180(), 4096)
//     println("${d.max_field}")                // 4096
// ```
pub fn with_max_field(d: Dialect, bytes: Int) -> Dialect
    Dialect { delim: d.delim, quote: d.quote, escape: d.escape,
              comment: d.comment, has_header: d.has_header, trim: d.trim,
              strict: d.strict, max_field: bytes }

// True when `b` is a byte the scanner could meet in a file.
fn is_byte(b: Int) -> Bool
    b >= 0 and b <= BYTE_MAX

// True when `b` is a byte or the `-1` that turns a feature off.
fn is_byte_or_off(b: Int) -> Bool
    b == NO_BYTE or is_byte(b)

// `None` when the dialect is usable, and the reason when it is not.
//
// The combinations refused, all of which make the scanner ambiguous
// rather than merely unusual: a delimiter equal to the quote, to the
// escape or to the comment byte; a quote equal to the escape byte; any
// of the four outside `-1 ..= 255`; a delimiter or a quote of `-1`,
// which no file can be read without; a negative `max_field`.
//
// `reader.reader` and `writer.writer` both call this.  A caller who
// does not call it is not skipping the check.  They are choosing to
// find out later.
//
// ```novo
// use dialect
//
// fn main() [io]
//     let bad = dialect.with_quote(dialect.rfc4180(), 0x2C)  // ',' twice
//     match dialect.check(bad)
//         Some(_) => println("refused")
//         None    => println("fine")
// ```
pub fn check(d: Dialect) -> ?CsvError
    if not is_byte(d.delim)
        Some(BadDialect("the delimiter ${d.delim} is not a byte in 0..=255"))
    else if not is_byte(d.quote)
        Some(BadDialect("the quote ${d.quote} is not a byte in 0..=255"))
    else if not is_byte_or_off(d.escape)
        Some(BadDialect("the escape ${d.escape} is neither a byte nor -1"))
    else if not is_byte_or_off(d.comment)
        Some(BadDialect("the comment byte ${d.comment} is neither a byte nor -1"))
    else if d.delim == d.quote
        Some(BadDialect("the delimiter and the quote are both ${d.delim}"))
    else if d.delim == d.escape
        Some(BadDialect("the delimiter and the escape are both ${d.delim}"))
    else if d.delim == d.comment
        Some(BadDialect("the delimiter and the comment byte are both ${d.delim}"))
    else if d.quote == d.escape
        Some(BadDialect("the quote and the escape are both ${d.quote}"))
    else if d.max_field < 0
        Some(BadDialect("a field bound of ${d.max_field} bounds nothing; 0 is unbounded"))
    else
        None
