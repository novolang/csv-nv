// record.nv — a parsed record, and the two ways to ask it for a field.
//
// A `Row` is a list of strings and not a map.  A CSV file has no types
// and its header is optional, so the only thing a parser can honestly
// hand back is the fields in order.  A map from header name to value
// looks friendlier and is a worse fit.  It loses the order the file
// had, it cannot represent a duplicate header, which real files have,
// and it costs one allocation per field per record on a file whose
// whole point is that there are millions of them.  A `Row` is the
// fields, and the header is a separate value the caller holds once.
// `Header` is that value, and it turns a name into an index.
//
// That split is what makes the by-name calls below cheap.  `int_of` is
// `column` then `int_at`, and `column` searches a list that is as long
// as the file is wide, once per lookup, rather than hashing every
// field of every record on the chance somebody asks.
//
// Every typed read answers a `Result` and not an option.  "This column
// is not a number" and "there is no such column" are different
// problems with different fixes.  A caller typing a column, which is
// what a statistics tool does with every column before it can decide
// anything, needs to tell them apart on the first record rather than
// after the run, and `?Int` collapses them.  `field` stays an option
// because there is only one way to fail: the index is off the end.
//
// The `col` of a typed failure is the 1-based field number, not a byte
// offset into the line.  A `Row` carries its fields and the line it
// started on, and not the line's text, so there is no byte to point
// at.  `csverror`'s module comment is where that split is written
// down.

// The bytes this module names, spelled once so that the scans below
// read as rules rather than as arithmetic.
const PLUS: Int = 43
const MINUS: Int = 45
const DIGIT_0: Int = 48
const DIGIT_9: Int = 57

// One parsed record, with the two numbers a message needs.
//
// ```novo
// use record
//
// fn main() [io]
//     let r = Row { fields: ["alice", "30"], line: 2, index: 0 }
//     println("${record.width(r)} at line ${r.line}")   // 2 at line 2
// ```
pub struct Row
    // The fields, in file order, unquoted and unescaped.  A field the
    // file wrote as `""` is the empty string; a field the file did not
    // write at all is not here, which is what makes `width` worth
    // asking about.
    fields: [Str]
    // The 1-based line the record started on, and not the line it
    // ended on.  A quoted field may span lines, and the place a person
    // goes to look is where the record began.
    line: Int
    // The 0-based record number, header excluded.  Under a dialect
    // with `has_header` the first data record is `0` and sits on line
    // 2.  The pair says both things, and neither can be derived from
    // the other once a quoted field has spanned a line.
    index: Int

// The header record, as a name-to-index question.
//
// Duplicate names are kept.  The file had them, and dropping one
// would silently discard a column.  `column` answers with the first
// index a name appears at, which is what every other CSV library does
// and what a caller writing `column("id")` on a file with two `id`
// columns almost certainly meant.
//
// ```novo
// use record
//
// fn main() [io]
//     let h = Header { names: ["name", "age"] }
//     println("${record.names(h)}")
// ```
pub struct Header
    // The column names, in file order, unquoted and unescaped.
    names: [Str]

// How many fields this record has.
//
// Worth asking on every record under a lenient dialect: RFC 4180 says
// every record has the same number of fields and real files disagree,
// so `strict` is what turns the disagreement into `RaggedRow` and this
// is what a lenient caller uses instead.
//
// ```novo
// use record
//
// fn main() [io]
//     println("${record.width(Row { fields: ["a", "b"], line: 1, index: 0 })}")
// ```
pub fn width(row: Row) -> Int
    list.len(row.fields)

// The field at a 0-based index, or `None` past the end.
//
// The one lookup that cannot fail for an interesting reason, so it is
// the one that returns an option rather than a `Result`.
//
// ```novo
// use record
//
// fn main() [io]
//     let r = Row { fields: ["alice", "30"], line: 2, index: 0 }
//     match record.field(r, 1)
//         Some(v) => println(v)                // 30
//         None    => println("no such field")
// ```
pub fn field(row: Row, i: Int) -> ?Str
    if i < 0 or i >= list.len(row.fields)
        None
    else
        Some(row.fields[i])

// The field at an index, or the `RaggedRow` that says the record never
// reached it.
//
// The shared first step of every typed read below: they all have to
// turn a missing field into an error rather than into a `None`, and
// they all have to blame the same thing when it is missing — a record
// too short for the index asked of it.
fn field_or_ragged(row: Row, i: Int) -> Result<Str, CsvError>
    match field(row, i)
        Some(v) => Ok(v)
        None    => Err(RaggedRow(row.line, i + 1, list.len(row.fields)))

// The field under a header name.
//
// `NoSuchColumn` when the header has no such name, which is a fault in
// the caller's spelling; `RaggedRow` when the header has it but this
// record is too short to have reached it, which is a fault in the
// file.  Two reasons, because the two fixes are in different places.
//
// ```novo
// use record
//
// fn main() [io]
//     let h = Header { names: ["name", "age"] }
//     let r = Row { fields: ["alice", "30"], line: 2, index: 0 }
//     match record.field_of(r, h, "age")
//         Ok(v)  => println(v)                 // 30
//         Err(_) => println("missing")
// ```
pub fn field_of(row: Row, head: Header, name: Str) -> Result<Str, CsvError>
    match column(head, name)
        None    => Err(NoSuchColumn(name))
        Some(i) =>
            match field(row, i)
                Some(v) => Ok(v)
                None    => Err(RaggedRow(row.line, list.len(head.names),
                                         list.len(row.fields)))

// The 0-based index of a name the header has, or the `NoSuchColumn`
// that says it has not.
//
// The shared first step of the three by-name reads, which otherwise
// each spell the same `match` before doing their own work.
fn column_or_missing(head: Header, name: Str) -> Result<Int, CsvError>
    match column(head, name)
        Some(i) => Ok(i)
        None    => Err(NoSuchColumn(name))

// The field at an index, read as a decimal integer.
//
// Accepts an optional leading `+` or `-` and then digits, with
// surrounding spaces ignored whatever the dialect's `trim` says.  A
// number with a space around it is a number, and the alternative is a
// caller who has to trim before every typed read.  Nothing else is
// accepted: no thousands separators, no underscores, no hexadecimal.
// A file that writes `1,234` has written two fields and this package
// will not guess otherwise.
//
// `NotAnInt` carries the text, so the caller's message can quote it.
//
// ```novo
// use record
//
// fn main() [io]
//     let r = Row { fields: ["alice", "30"], line: 2, index: 0 }
//     match record.int_at(r, 1)
//         Ok(n)  => println("${n + 1}")        // 31
//         Err(_) => println("not a number")
// ```
pub fn int_at(row: Row, i: Int) -> Result<Int, CsvError>
    let text = field_or_ragged(row, i)!
    match str.to_int(str.trim(text))
        Some(n) => Ok(n)
        None    => Err(NotAnInt(row.line, i + 1, text))

// The field under a header name, read as a decimal integer.
//
// ```novo
// use record
//
// fn main() [io]
//     let h = Header { names: ["name", "age"] }
//     let r = Row { fields: ["alice", "30"], line: 2, index: 0 }
//     match record.int_of(r, h, "age")
//         Ok(n)  => println("${n}")            // 30
//         Err(_) => println("not a number")
// ```
pub fn int_of(row: Row, head: Header, name: Str) -> Result<Int, CsvError>
    int_at(row, column_or_missing(head, name)!)

// True when `text` begins the way a decimal number does: an optional
// sign and then a digit.
//
// This is what keeps `inf`, `nan` and a bare `.5` out of `float_at`.
// `str.to_float` accepts all three, and all three are far more often a
// truncated field or a spreadsheet's error cell than a number somebody
// meant to write.
fn starts_like_a_number(text: Str) -> Bool
    var at = 0
    let sign = str.byte_at_or(text, 0, -1)
    if sign == PLUS or sign == MINUS
        at = 1
    let b = str.byte_at_or(text, at, -1)
    b >= DIGIT_0 and b <= DIGIT_9

// The field at an index, read as a float.
//
// Accepts what `int_at` accepts plus a decimal point and an `e`
// exponent — the spelling `str.to_float` accepts, so that a file
// round-trips through this package and the standard library the same
// way.  Not accepted: `NaN`, `inf`, and a bare `.5`, all of which are
// far more often a truncated field than a number somebody meant.
//
// ```novo
// use record
//
// fn main() [io]
//     let r = Row { fields: ["fee", "1.25"], line: 2, index: 0 }
//     match record.float_at(r, 1)
//         Ok(f)  => println("${f}")            // 1.25
//         Err(_) => println("not a number")
// ```
pub fn float_at(row: Row, i: Int) -> Result<Float, CsvError>
    let text = field_or_ragged(row, i)!
    let body = str.trim(text)
    if not starts_like_a_number(body)
        return Err(NotAFloat(row.line, i + 1, text))
    match str.to_float(body)
        Some(f) => Ok(f)
        None    => Err(NotAFloat(row.line, i + 1, text))

// The field under a header name, read as a float.
//
// ```novo
// use record
//
// fn main() [io]
//     let h = Header { names: ["item", "amount"] }
//     let r = Row { fields: ["fee", "1.25"], line: 2, index: 0 }
//     match record.float_of(r, h, "amount")
//         Ok(f)  => println("${f}")            // 1.25
//         Err(_) => println("not a number")
// ```
pub fn float_of(row: Row, head: Header, name: Str) -> Result<Float, CsvError>
    float_at(row, column_or_missing(head, name)!)

// The field at an index, read as a boolean.
//
// The accepted set, case-insensitively: `true`, `false`, `t`, `f`,
// `yes`, `no`, `y`, `n`, `1`, `0`.  It is written out here because a
// boolean column is the one place CSV libraries quietly differ, and a
// caller who knows the set can decide whether their file is in it
// before running over a million records.  An empty field is not
// false.  It is `NotABool`, because a spreadsheet's empty cell means
// that nobody said, and turning that into `false` is a decision this
// package is not entitled to make.
//
// Surrounding spaces are ignored, as they are for `int_at`.
//
// ```novo
// use record
//
// fn main() [io]
//     let r = Row { fields: ["paid", "yes"], line: 2, index: 0 }
//     match record.bool_at(r, 1)
//         Ok(b)  => println("${b}")            // true
//         Err(_) => println("not a boolean")
// ```
pub fn bool_at(row: Row, i: Int) -> Result<Bool, CsvError>
    let text = field_or_ragged(row, i)!
    let word = str.lower(str.trim(text))
    if word == "true" or word == "t" or word == "yes" or word == "y" or word == "1"
        Ok(true)
    else if word == "false" or word == "f" or word == "no" or word == "n" or word == "0"
        Ok(false)
    else
        Err(NotABool(row.line, i + 1, text))

// The field under a header name, read as a boolean.
//
// ```novo
// use record
//
// fn main() [io]
//     let h = Header { names: ["item", "paid"] }
//     let r = Row { fields: ["fee", "yes"], line: 2, index: 0 }
//     match record.bool_of(r, h, "paid")
//         Ok(b)  => println("${b}")            // true
//         Err(_) => println("not a boolean")
// ```
pub fn bool_of(row: Row, head: Header, name: Str) -> Result<Bool, CsvError>
    bool_at(row, column_or_missing(head, name)!)

// This record read as a header.
//
// For the caller who parsed with `has_header` off, because they had to
// look at the first record to decide whether it was a header, and then
// decided it was.  `reader.header_row` is the other route, for the
// caller who knew in advance.
//
// ```novo
// use record
//
// fn main() [io]
//     let first = Row { fields: ["name", "age"], line: 1, index: 0 }
//     println("${record.names(record.header(first))}")
// ```
pub fn header(row: Row) -> Header
    Header { names: row.fields }

// The 0-based index of a column name, or `None`.
//
// The first index, when the header repeats a name.  A caller who needs
// the second one reads `names` and searches it themselves.  There is no
// `column_all`, because a file with duplicate headers is a file whose
// reader has to decide something, and a second call would let them not
// decide it.
//
// ```novo
// use record
//
// fn main() [io]
//     let h = Header { names: ["name", "age"] }
//     match record.column(h, "age")
//         Some(i) => println("${i}")           // 1
//         None    => println("no such column")
// ```
pub fn column(head: Header, name: Str) -> ?Int
    let n = list.len(head.names)
    for i in 0..n
        if head.names[i] == name
            return Some(i)
    None

// The column names, in file order.
//
// ```novo
// use record
//
// fn main() [io]
//     for n in record.names(Header { names: ["name", "age"] })
//         println(n)
// ```
pub fn names(head: Header) -> [Str]
    head.names
