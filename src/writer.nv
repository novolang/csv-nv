// writer.nv — records to bytes, and the bytes go wherever the caller
// puts them.
//
// A LIBRARY DOES NOT PRINT, and in a `core` package it also cannot:
// the budget is no effects at all, so there is no version of this
// module that takes a file.  `write_row` returns the bytes of one
// record and the caller writes them — to a file, to a socket, into a
// buffer, into a checksum.  That is the same constraint the reader has
// and it produces the same shape from the other side.
//
// WHY IT IS A `Writer` AND NOT A FREE FUNCTION
//
// Two things have to be remembered between records and neither is in
// the record: the dialect, and whether anything has been written yet.
// The second is what decides a header — a writer that has emitted
// nothing may still write one — and what a caller would otherwise
// track with a boolean beside every call.  So the state is a value,
// and like the reader it is threaded rather than mutated, because
// `[mutate]` is a host effect.
//
// WHAT IT GUARANTEES
//
// `reader.parse(writer output, same dialect)` gives back the records
// that went in.  That round trip is the only promise worth making
// about a CSV writer and it is the one this package's tests are built
// around: quoting is applied where the dialect requires it and nowhere
// else, and a field holding the delimiter, the quote byte, a CR or an
// LF is always quoted.
//
// A WRITER THAT CANNOT WRITE EMITS NOTHING.  Three refusals, all of
// them the empty byte string and an unchanged writer, because there is
// no error channel on a `(Writer, Bytes)`: a dialect `dialect.check`
// refuses, a header after the first record, and — under a `strict`
// dialect — a record of a different width from the first.  The writer
// is a value the caller threads, so a refusal is visible as a `rows`
// that did not move.

use dialect

// The two bytes RFC 4180 § 2.1 terminates a record with, and the
// string they spell.  Not a dialect field: a writer whose line ending
// varied is a writer whose output nobody can predict from the dialect
// they were handed.
const BYTE_CR: Int = 13
const BYTE_LF: Int = 10
const TERMINATOR: Str = "\r\n"

// The `escape` a dialect carries when it has none and RFC 4180's
// doubling applies.
const NO_ESCAPE: Int = -1

// A CSV writer between records.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     let w = writer.writer(dialect.rfc4180())
//     println("${w.rows}")                     // 0
// ```
pub struct Writer
    // The dialect this writer was built with, unchanged.
    dialect: Dialect
    // How many records have been emitted, header included.  `0` is
    // what makes `write_header` legal.
    rows: Int
    // The width the first record set, or `-1` before it.  Under a
    // `strict` dialect a later record of a different width is refused;
    // otherwise it is written as it stands.
    width: Int

// A writer that has emitted nothing.
//
// Like `reader.reader`, a dialect `dialect.check` refuses produces a
// writer that emits nothing rather than a constructor that fails.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     let w = writer.writer(dialect.tsv())
//     println("${w.width}")                    // -1
// ```
pub fn writer(d: Dialect) -> Writer
    Writer { dialect: d, rows: 0, width: -1 }

// True when this dialect is one a file can be written in.
//
// The same `dialect.check` the reader calls, read as a boolean because
// a writer has nowhere to put the reason: it answers `(Writer, Bytes)`
// and the refusal is the empty `Bytes`.
fn usable(d: Dialect) -> Bool
    match dialect.check(d)
        Some(_) => false
        None    => true

// The header record, as bytes.
//
// Legal only as the first thing a writer emits; afterwards it returns
// empty bytes and leaves the writer alone, because a header in the
// middle of a file is not a thing this package will produce.  It is a
// separate call from `write_row` so that a caller round-tripping a
// file can hand back the `Header` the reader gave them without
// unpacking it.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     let w = writer.writer(dialect.rfc4180())
//     let (_, out) = writer.write_header(w, Header { names: ["name", "age"] })
//     println("${bytes.len(out)}")             // 10 — "name,age\r\n"
// ```
pub fn write_header(w: Writer, head: Header) -> (Writer, Bytes)
    if w.rows != 0
        (w, bytes.from_str(""))
    else
        write_row(w, head.names)

// One record, as bytes, terminated.
//
// The terminator is CRLF, which is what RFC 4180 § 2.1 says and what
// every spreadsheet writes.  A caller who wants LF writes the rows
// into their own buffer and does not get to ask this package for it —
// a writer with a line-ending flag is a writer whose output nobody can
// predict from the dialect they were handed.
//
// A field is quoted when it contains the delimiter, the quote, a
// carriage return or a line feed, and not otherwise: `needs_quote` is
// that rule, exposed, because a caller building a header by hand wants
// the same answer.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     let w = writer.writer(dialect.rfc4180())
//     let (_, out) = writer.write_row(w, ["alice", "de Vries, A"])
//     println("${bytes.len(out)}")             // quoted second field
// ```
pub fn write_row(w: Writer, fields: [Str]) -> (Writer, Bytes)
    if not usable(w.dialect)
        return (w, bytes.from_str(""))
    if w.dialect.strict and w.width >= 0 and list.len(fields) != w.width
        return (w, bytes.from_str(""))
    var quoted: [Str] = []
    for f in fields
        quoted = list.push(quoted, quote_field(w.dialect, f))
    let text = str.join(quoted, str.from_char(w.dialect.delim)) + TERMINATOR
    var settled = w.width
    if settled < 0
        settled = list.len(fields)
    let next = Writer { dialect: w.dialect, rows: w.rows + 1, width: settled }
    (next, bytes.from_str(text))

// Several records, as one run of bytes.
//
// The same as calling `write_row` in a loop and concatenating, and it
// is here because the loop is otherwise written at every call site
// with a different accumulator.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     let w = writer.writer(dialect.rfc4180())
//     let (_, out) = writer.write_rows(w, [["a", "b"], ["c", "d"]])
//     println("${bytes.len(out)}")             // 10 — two CRLF records
// ```
pub fn write_rows(w: Writer, rows: [[Str]]) -> (Writer, Bytes)
    var cur = w
    var parts: [Bytes] = []
    for row in rows
        let (next, out) = write_row(cur, row)
        cur = next
        parts = list.push(parts, out)
    (cur, bytes.concat(parts))

// Whether this field has to be quoted under this dialect.
//
// True when the field contains the delimiter, the quote byte, a
// carriage return or a line feed.  Not for a leading space: RFC 4180
// § 2.4 makes the space part of the field, so a reader that does not
// trim reads it back correctly unquoted, and a reader that does trim
// was asked to.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     println("${writer.needs_quote(dialect.rfc4180(), "de Vries, A")}")  // true
//     println("${writer.needs_quote(dialect.rfc4180(), "alice")}")        // false
// ```
pub fn needs_quote(d: Dialect, field: Str) -> Bool
    let n = str.len(field)
    for i in 0..n
        let b = str.byte_at_or(field, i, -1)
        if b == d.delim or b == d.quote or b == BYTE_CR or b == BYTE_LF
            return true
    false

// This field as it will appear in the file: quoted if it has to be,
// with the inner quotes escaped the way the dialect says.
//
// Doubling by default (RFC 4180 § 2.7), or the dialect's `escape` byte
// when it has one — and a dialect with an escape byte escapes that
// byte too, so that a field holding a backslash comes back holding a
// backslash.  Exposed because a caller writing a file this package
// does not otherwise produce — a header comment, a footer — still
// needs one field spelled correctly.
//
// ```novo
// use writer
// use dialect
//
// fn main() [io]
//     println(writer.quote_field(dialect.rfc4180(), "say \"hi\""))
//     // "say ""hi"""
// ```
pub fn quote_field(d: Dialect, field: Str) -> Str
    if not needs_quote(d, field)
        return field
    let q = str.from_char(d.quote)
    var out = q
    let n = str.len(field)
    for i in 0..n
        let b = str.byte_at_or(field, i, -1)
        if b == d.quote and d.escape == NO_ESCAPE
            out = out + q + q
        else if b == d.quote
            out = out + str.from_char(d.escape) + q
        else if b == d.escape
            out = out + str.from_char(d.escape) + str.from_char(d.escape)
        else
            out = out + str.slice(field, i, i + 1)
    out + q
