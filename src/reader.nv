// reader.nv — a CSV reader that performs nothing.
//
// `csv-nv` is a `core` package, so it declares no effects at all and it
// may not read a file, a socket or standard input.  A CSV file is
// exactly the thing a caller wants to stream.  Those two facts are
// reconciled by a feed-and-drain state machine.  The host holds the
// stream, hands this package whatever bytes it has, and gets back the
// records those bytes completed plus a reader to hand the next chunk
// to.  Nothing here reads and nothing here waits.
//
//     var r = reader.reader(dialect.rfc4180())
//     let (r2, rows) = reader.feed(r, chunk)     // as many times as you like
//     let rest = reader.finish(r2)!              // once, at end of stream
//
// A chunk may split anything.  A field, a quoted field containing a
// newline, a CRLF between the CR and the LF.  The reader carries
// whatever it could not finish into the next call.  That is the whole
// contract, and it is why `feed` returns a new reader rather than
// mutating one: `[mutate]` is a host effect and this package has none.
//
// `read_all` is the same machine with the loop inside it.
//
//     pub fn read_all<S: Read[e]>(src: S, d: Dialect) -> … [e]
//
// The bound binds `Read`'s effect parameter and the clause uses it
// (SPEC § 5.6), so this one function costs whatever the caller's
// stream costs.  A file charges `[io]`, a socket `[io, net]`, an
// in-memory buffer nothing, and the package stays `core`, because the
// impl that supplies the effect is declared where the host is.  It is
// here so that the callers who have a file do not write the pump.
//
// RFC 4180 describes a well-formed file and says nothing about the
// files people have.  Five decisions fill that gap, each of them the
// reading every other library takes, written here so that nobody has
// to read the scanner to find out.
//
//   - A blank line is not a record.  A line whose terminator arrives
//     with no field open and none finished is skipped, which is also
//     what makes the newline at the end of a well-formed file produce
//     nothing.  A line holding one empty quoted field (`""`) is a
//     record of one empty field, because the quotes say so.
//   - A file may end without a terminator, which § 2.2 makes optional.
//     `finish` is where that last record comes out.
//   - A lone CR ends a line.  The RFC's terminator is CRLF, and a file
//     that lost its LFs is still a file, so a CR ends the record and a
//     following LF is its second half rather than a blank line.
//   - A bare quote in an unquoted field, which § 2.5 forbids, is data
//     under a lenient dialect and `BareQuote` under a strict one.  Text
//     after a closing quote is the same defect seen from the other
//     side, and it is reported the same way.
//   - An empty document is zero records, not one empty record.
//
// This package does not decode.  A field is bytes that came out of the
// file with the quoting removed, handed back as a `Str` without being
// validated as UTF-8, so a file in any byte encoding reads.  It does
// not infer types either.  `record`'s typed reads are asked for, one
// column at a time, by a caller who decided.

use dialect
use record

// The two bytes that end a line, named once.
const LF: Int = 10
const CR: Int = 13

// Where the scanner is.  `Reader.state` is one of these, as an `Int`
// so that the whole reader stays copyable cheaply.
//
// The two that are not in the informal description of a CSV scanner
// are the ones a CHUNK BOUNDARY forces into existence: a CR whose LF
// may be in the next chunk, and an escape byte whose escaped byte may
// be.  A machine that a chunk may split anywhere has to be able to
// stop between any two bytes, including those two.
const S_FIELD_START: Int = 0
const S_UNQUOTED: Int = 1
const S_QUOTED: Int = 2
const S_QUOTE_SEEN: Int = 3
const S_COMMENT: Int = 4
const S_CR: Int = 5
const S_ESCAPE: Int = 6

// The sticky failure a reader carries, as a code.  `error` reads one
// back as the `CsvError` it stands for, with the position and the
// bound the reader recorded beside it.
//
// `UnterminatedQuote` is not among them because no `feed` can produce
// it: a quoted field that is still open at the end of a chunk is a
// quoted field that the next chunk may close.  Only `finish` knows
// there is no next chunk.
const F_NONE: Int = -1
const F_BAD_DIALECT: Int = 0
const F_BARE_QUOTE: Int = 1
const F_RAGGED: Int = 2
const F_FIELD_TOO_LONG: Int = 3

// A CSV reader between chunks.
//
// Opaque in practice — the fields are here so that the state is
// reviewable rather than because a caller should read them — and
// carried by value: `feed` returns the next one and the previous one
// is finished with.  A reader that has failed stays failed; `error`
// is what says so, and every subsequent `feed` emits nothing.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     let r = reader.reader(dialect.rfc4180())
//     println("${r.line}")                     // 1
// ```
pub struct Reader
    // The dialect this reader was built with, unchanged.
    dialect: Dialect
    // The 1-based line the scanner is on.  Advances on a record
    // separator and on a newline inside a quoted field, because it is
    // a position in the file, not a record count.
    line: Int
    // The 1-based byte column within that line.  It is the column of
    // the next byte to be fed, which is `1` on a reader that has just
    // met a line break.
    col: Int
    // How many records have been emitted, header excluded.  The next
    // `Row` gets this as its `index`.
    index: Int
    // Where the scanner is: one of the `S_*` codes above.
    state: Int
    // Fields of the record currently being built, complete so far.
    pending: [Str]
    // The bytes of the field currently being built.
    partial: Str
    // The header, once `has_header` has consumed it; empty before.
    // Empty is also what says it has not been consumed, which is why a
    // blank line is skipped rather than becoming a header of one empty
    // name.
    head: [Str]
    // The line the record currently being built started on.  Not
    // derivable from `line`, which a quoted newline has already moved
    // on; it is what a `Row` carries and what a person is sent to.
    row_line: Int
    // The line the field currently being built started on, and the
    // column it started at.  For a quoted field that is the opening
    // quote — the byte `UnterminatedQuote` sends a person to, and the
    // one place a scanner cannot recompute once it has read past it.
    field_line: Int
    field_col: Int
    // How many fields wide this file is, or `-1` before the first
    // record settled it.  Under a `strict` dialect it is what a later
    // record is measured against, and it is `RaggedRow`'s `want`.
    width: Int
    // The sticky failure, or `-1`.  `error` reads it back as a
    // `CsvError` with the position it was recorded at.
    failed: Int
    // The line the sticky failure was recorded at, or `-1`.
    failed_line: Int
    // The column the sticky failure was recorded at, or `-1`.  For a
    // `RaggedRow` it is the width the record actually had, which has
    // no column to name.
    failed_col: Int

// A reader at the start of a file.
//
// A dialect `dialect.check` refuses does not fail here — there is no
// error channel on a constructor — it produces a reader that is
// already failed, so the first `feed` emits nothing and `error`
// answers `BadDialect`.  That is one failure path instead of two, and
// it is checkable before a byte is read by calling `dialect.check`
// yourself.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     let r = reader.reader(dialect.tsv())
//     match reader.error(r)
//         Some(_) => println("bad dialect")
//         None    => println("ready")
// ```
pub fn reader(d: Dialect) -> Reader
    var code = F_NONE
    match dialect.check(d)
        Some(_) =>
            code = F_BAD_DIALECT
        None    =>
            code = F_NONE
    Reader { dialect: d, line: 1, col: 1, index: 0, state: S_FIELD_START,
             pending: [], partial: "", head: [],
             row_line: 1, field_line: 1, field_col: 1, width: -1,
             failed: code, failed_line: -1, failed_col: -1 }

// The offset one past the run of ordinary bytes beginning at `from` —
// bytes that are neither of the two the current state stops on, nor a
// line break.
//
// The scanner appends a run at a time rather than a byte at a time,
// which is what keeps a field's cost linear in its length: `partial +
// one byte` allocates a fresh string per byte, and over a file of a
// million records that is the whole difference.  Line breaks are left
// out of every run so that the line and column bookkeeping stays in
// one place — the byte-at-a-time path.
fn run_end(chunk: Str, from: Int, n: Int, stop1: Int, stop2: Int) -> Int
    for j in from..n
        let c = str.byte_at_or(chunk, j, -1)
        if c == stop1 or c == stop2 or c == LF or c == CR
            return j
    n

// One unquoted field as it will be handed back, trimmed if the
// dialect says so.
//
// A quoted field never comes through here.  RFC 4180 § 2.4 makes the
// space part of the field and the quotes are what say it was meant, so
// `trim` is about the fields nobody quoted.
fn close_field(d: Dialect, text: Str) -> Str
    if d.trim
        str.trim(text)
    else
        text

// What finishing one record produced.  `rows` holds the one row it
// completed, or none for a header or a failure, and the caller adds it
// to the rows it is collecting.
//
// A struct because the alternative is the block below written twice —
// once for the record a `feed` completed, once for the record `finish`
// releases — and two copies of "is this the header, is it the right
// width, what number does it get" are two copies that drift.
struct CsvEmit
    rows: [Row]
    // Whether the record was the header, consumed rather than emitted.
    // The header is then the record's own fields.
    took_head: Bool
    index: Int
    width: Int
    failed: Int
    failed_line: Int
    failed_col: Int

// The one place a completed record becomes a `Row`, a header, or a
// `RaggedRow`.
fn emit_record(d: Dialect, fields: [Str], row_line: Int, head_missing: Bool, index: Int,
               width: Int) -> CsvEmit
    if d.has_header and head_missing
        // The first record of a `has_header` file is consumed rather
        // than emitted, and it is also what settles the width the rest
        // of the file is measured against.
        CsvEmit { rows: [], took_head: true, index: index,
                  width: list.len(fields), failed: F_NONE,
                  failed_line: -1, failed_col: -1 }
    else if d.strict and width >= 0 and list.len(fields) != width
        CsvEmit { rows: [], took_head: false, index: index, width: width,
                  failed: F_RAGGED, failed_line: row_line,
                  failed_col: list.len(fields) }
    else
        var settled = width
        if settled < 0
            settled = list.len(fields)
        let row = Row { fields: fields, line: row_line, index: index }
        CsvEmit { rows: [row], took_head: false,
                  index: index + 1, width: settled, failed: F_NONE,
                  failed_line: -1, failed_col: -1 }

// Feed the next chunk.  The answer is the reader to feed the chunk
// after it, and every record those bytes completed.
//
// A record is complete when a record separator has been seen outside a
// quoted field.  A chunk that ends mid-record produces no row for it
// and the reader carries the partial state; a chunk that completes
// three records produces three rows.  An empty chunk is legal and
// completes nothing — it is not an end-of-stream signal, because a
// caller reading a socket gets empty reads for reasons that are not
// the end.  `finish` is the end-of-stream signal.
//
// A parse failure does not throw away the records already in this
// chunk: they are returned, the reader is left failed, and `error`
// says why.  A caller streaming a large file therefore keeps
// everything up to the corruption, which is what a person fixing the
// file wants to see.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     let r = reader.reader(dialect.with_header(dialect.rfc4180(), false))
//     let (_, rows) = reader.feed(r, bytes.from_str("a,b\n"))
//     println("${list.len(rows)}")             // 1
// ```
pub fn feed(r: Reader, chunk: Bytes) -> (Reader, [Row])
    feed_str(r, bytes.to_str(chunk))

// `feed` for a caller who has a `Str`.
//
// The same machine — the string is read as its bytes — and it exists
// because a caller who has already read a file into a string should
// not have to convert it back to bytes to hand it over.  It is also
// where the machine itself is written: `feed` is this function over
// `bytes.to_str`, which is a re-tag rather than a copy.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     let r = reader.reader(dialect.with_header(dialect.rfc4180(), false))
//     let (_, rows) = reader.feed_str(r, "a,b\nc,d\n")
//     println("${list.len(rows)}")             // 2
// ```
pub fn feed_str(r: Reader, chunk: Str) -> (Reader, [Row])
    if r.failed != F_NONE
        return (r, [])

    let d = r.dialect
    var line = r.line
    var col = r.col
    var index = r.index
    var state = r.state
    // A copy of the unfinished record, because the fields that arrive
    // are pushed onto it and the reader handed in stays as it was.
    var pending = list.clone(r.pending)
    var partial = r.partial
    // The header this chunk consumed, if it held one.  The reader's
    // own header is carried over unchanged otherwise.
    var head_missing = list.len(r.head) == 0
    var took: [Str] = []
    var took_any = false
    var row_line = r.row_line
    var field_line = r.field_line
    var field_col = r.field_col
    var width = r.width
    var failed = F_NONE
    var failed_line = -1
    var failed_col = -1
    var rows: [Row] = []

    // Not a counted loop: the CR state hands its byte back unconsumed,
    // so `i` advances at the foot of the body rather than at the head,
    // and the first condition is the one that ends the scan early — a
    // failure is sticky, and nothing after it is read.
    let n = str.len(chunk)
    var i = 0
    while failed == F_NONE and i < n
        let b = str.byte_at_or(chunk, i, -1)
        // Whether this byte was consumed by this pass, and whether it
        // ended a record.  A byte the CR state hands back is looked at
        // twice — once to release the record the CR finished, once as
        // the first byte of the record after it.
        var eaten = true
        var complete = false

        if state == S_CR
            // The CR already ended the line and already closed the
            // field; what is left is to release the record it finished
            // and to swallow the LF of a CRLF.
            state = S_FIELD_START
            complete = list.len(pending) > 0
            eaten = b == LF
        else if state == S_COMMENT
            if b == LF
                state = S_FIELD_START
                line = line + 1
                col = 1
            else if b == CR
                state = S_CR
                line = line + 1
                col = 1
            else
                col = col + 1
        else if state == S_ESCAPE
            // Whatever follows the escape byte is data, including a
            // quote, a delimiter and the escape byte itself.
            partial = partial + str.slice(chunk, i, i + 1)
            state = S_QUOTED
            if b == LF
                line = line + 1
                col = 1
            else
                col = col + 1
        else if state == S_QUOTED
            if b == d.escape
                state = S_ESCAPE
                col = col + 1
            else if b == d.quote
                state = S_QUOTE_SEEN
                col = col + 1
            else if b == LF
                partial = partial + str.slice(chunk, i, i + 1)
                line = line + 1
                col = 1
            else if b == CR
                // A CR inside a quoted field is data, and it is the LF
                // beside it that moves the line on.
                partial = partial + str.slice(chunk, i, i + 1)
                col = col + 1
            else
                let j = run_end(chunk, i, n, d.quote, d.escape)
                partial = partial + str.slice(chunk, i, j)
                col = col + (j - i)
                i = j - 1
        else if state == S_QUOTE_SEEN
            if b == d.quote
                // RFC 4180 § 2.7: a doubled quote is one quote of data.
                partial = partial + str.slice(chunk, i, i + 1)
                state = S_QUOTED
                col = col + 1
            else if b == d.delim
                pending = list.push(pending, partial)
                partial = ""
                state = S_FIELD_START
                col = col + 1
            else if b == LF
                pending = list.push(pending, partial)
                partial = ""
                state = S_FIELD_START
                complete = true
                line = line + 1
                col = 1
            else if b == CR
                pending = list.push(pending, partial)
                partial = ""
                state = S_CR
                line = line + 1
                col = 1
            else if d.strict
                // Text after a closing quote is the same defect as a
                // bare quote inside an unquoted field, seen from the
                // other side; the position is the byte that should
                // have ended the field.
                failed = F_BARE_QUOTE
                failed_line = line
                failed_col = col
            else
                partial = partial + str.slice(chunk, i, i + 1)
                state = S_UNQUOTED
                col = col + 1
        else if state == S_UNQUOTED
            if b == d.delim
                pending = list.push(pending, close_field(d, partial))
                partial = ""
                state = S_FIELD_START
                col = col + 1
            else if b == LF
                pending = list.push(pending, close_field(d, partial))
                partial = ""
                state = S_FIELD_START
                complete = true
                line = line + 1
                col = 1
            else if b == CR
                pending = list.push(pending, close_field(d, partial))
                partial = ""
                state = S_CR
                line = line + 1
                col = 1
            else if b == d.quote
                if d.strict
                    failed = F_BARE_QUOTE
                    failed_line = line
                    failed_col = col
                else
                    partial = partial + str.slice(chunk, i, i + 1)
                    col = col + 1
            else
                let j = run_end(chunk, i, n, d.delim, d.quote)
                partial = partial + str.slice(chunk, i, j)
                col = col + (j - i)
                i = j - 1
        else
            // S_FIELD_START — the byte begins a field, and if nothing
            // of this record has been read yet it begins the record.
            if list.len(pending) == 0
                row_line = line
            field_line = line
            field_col = col
            if b == d.comment and col == 1 and list.len(pending) == 0
                state = S_COMMENT
                col = col + 1
            else if b == d.quote
                state = S_QUOTED
                col = col + 1
            else if b == d.delim
                pending = list.push(pending, "")
                col = col + 1
            else if b == LF
                // A blank line is not a record; a line that has
                // already produced a field ends with an empty one.
                if list.len(pending) > 0
                    pending = list.push(pending, "")
                    complete = true
                line = line + 1
                col = 1
            else if b == CR
                if list.len(pending) > 0
                    pending = list.push(pending, "")
                state = S_CR
                line = line + 1
                col = 1
            else
                state = S_UNQUOTED
                let j = run_end(chunk, i, n, d.delim, d.quote)
                partial = partial + str.slice(chunk, i, j)
                col = col + (j - i)
                i = j - 1

        if complete
            let done = emit_record(d, pending, row_line, head_missing, index, width)
            rows = list.append(rows, done.rows)
            if done.took_head
                took = pending
                took_any = true
                head_missing = false
            index = done.index
            width = done.width
            failed = done.failed
            failed_line = done.failed_line
            failed_col = done.failed_col
            pending = []
            partial = ""

        // The bound exists so that a file with one unclosed quote is
        // refused after a megabyte rather than after the whole of
        // itself, so it is checked as the field grows.
        if failed == F_NONE and d.max_field > 0 and str.len(partial) > d.max_field
            failed = F_FIELD_TOO_LONG
            failed_line = field_line
            failed_col = field_col

        if eaten
            i = i + 1

    let head = if took_any
        took
    else
        r.head
    let next = Reader { dialect: d, line: line, col: col, index: index,
                        state: state, pending: pending, partial: partial,
                        head: head, row_line: row_line,
                        field_line: field_line, field_col: field_col,
                        width: width, failed: failed,
                        failed_line: failed_line, failed_col: failed_col }
    (next, rows)

// End of stream: the last record, if the file did not end with a
// separator, and the verdict.
//
// RFC 4180 § 2.2 makes the final line break optional, so a file ending
// `bob,25` has a record in it that no `feed` has emitted — this is
// where it comes out.  A file ending with a separator has nothing left
// and this returns an empty list rather than a row of one empty
// field.
//
// `Err` when the reader is failed, including the failure a `feed`
// recorded earlier and the one only the end of the stream can find: a
// quoted field that was never closed.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     let r = reader.reader(dialect.with_header(dialect.rfc4180(), false))
//     let (r2, _) = reader.feed_str(r, "a,b")
//     match reader.finish(r2)
//         Ok(rows) => println("${list.len(rows)}")   // 1
//         Err(_)   => println("bad file")
// ```
pub fn finish(r: Reader) -> Result<[Row], CsvError>
    match error(r)
        Some(e) => Err(e)
        None    => finish_clean(r)

// `finish` for a reader that is not already carrying a failure.
//
// Split out so that the sticky failure is answered in one line above
// and the end-of-stream reasoning — is a field open, is a record
// unreleased, was a quote never closed — reads on its own.
fn finish_clean(r: Reader) -> Result<[Row], CsvError>
    // A quoted field the stream ended inside of can only be found
    // here: until the stream ends, the next chunk might close it.
    if r.state == S_QUOTED or r.state == S_ESCAPE
        return Err(UnterminatedQuote(r.field_line, r.field_col))

    // A copy, because the last field is pushed onto it and the reader
    // handed in stays as it was.
    var fields = list.clone(r.pending)
    var have = list.len(r.pending) > 0
    if r.state == S_UNQUOTED
        fields = list.push(fields, close_field(r.dialect, r.partial))
        have = true
    else if r.state == S_QUOTE_SEEN
        fields = list.push(fields, r.partial)
        have = true
    else if r.state == S_FIELD_START and have
        // `a,` — the record's last field is empty and the file ended
        // before its terminator.
        fields = list.push(fields, "")

    if not have
        return Ok([])

    let done = emit_record(r.dialect, fields, r.row_line, list.len(r.head) == 0, r.index,
                           r.width)
    if done.failed == F_RAGGED
        Err(RaggedRow(done.failed_line, done.width, done.failed_col))
    else
        Ok(done.rows)

// The sticky failure this reader is carrying, or `None`.
//
// Once set it is never cleared: a CSV file that has gone wrong at byte
// 40,000 does not come right again, and a reader that tried to
// resynchronise would be inventing records.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     let r = reader.reader(dialect.rfc4180())
//     match reader.error(r)
//         Some(_) => println("failed")
//         None    => println("fine")
// ```
pub fn error(r: Reader) -> ?CsvError
    if r.failed == F_BAD_DIALECT
        dialect.check(r.dialect)
    else if r.failed == F_BARE_QUOTE
        Some(BareQuote(r.failed_line, r.failed_col))
    else if r.failed == F_RAGGED
        Some(RaggedRow(r.failed_line, r.width, r.failed_col))
    else if r.failed == F_FIELD_TOO_LONG
        Some(FieldTooLong(r.failed_line, r.failed_col, r.dialect.max_field))
    else
        None

// The header, once a `has_header` dialect has consumed one.
//
// `None` before the first record has been seen, and `None` for ever
// under a dialect with `has_header` off — that caller has the header
// as the first `Row` and turns it into one with `record.header`.
//
// ```novo
// use reader
// use dialect
// use record
//
// fn main() [io]
//     let r = reader.reader(dialect.rfc4180())
//     let (r2, _) = reader.feed_str(r, "name,age\nalice,30\n")
//     match reader.header_row(r2)
//         Some(h) => println("${record.names(h)}")
//         None    => println("no header yet")
// ```
pub fn header_row(r: Reader) -> ?Header
    if list.len(r.head) == 0
        None
    else
        Some(Header { names: r.head })

// How many bytes `read_all` asks its source for at a time.
//
// 64 KiB: large enough that the per-call cost of a file read is
// amortised over a few hundred records, small enough that a reader
// over a socket does not sit on a buffer it will not fill.
const READ_CHUNK: Int = 65536

// Read a whole stream, and be charged exactly what the stream costs.
//
// `S: Read[e]` binds the effect parameter of the standard library's
// `Read` trait, and the clause is `[e]`.  The effect row therefore
// means whatever the impl behind `S` supplies.  The call site
// substitutes it, a `File` charges its caller `[io]`, an in-memory
// `Buffer` charges nothing, and this package remains `core` because it
// has not named an effect of its own (SPEC § 5.6, and
// `docs/publishing.md` § Design).
//
// It is the same machine as `feed` and `finish` with the pump written
// once, here, instead of once per caller.  Use `feed` when the bytes
// arrive from somewhere this does not fit, such as a frame decoder, a
// decompressor, or a chunk at a time from a browser.  Use this
// otherwise.
//
// `Transport` carries the stream's own `IoError` through, so a caller
// can still tell a timeout from a truncated file.
//
// The loop stops in three ways.  `Read`'s contract is that an empty
// result is end of stream and an `Err` is a transport failure, and this
// stops on the first empty read.  It also stops, without an error, on
// `IoClosed`.  A source that reports itself closed is a source with no
// more bytes, which is end of stream by another name, and the standard
// library's in-memory `Buffer` reports an exhausted buffer exactly that
// way.  A reader that treated it as a failure could not read a whole
// document out of memory.  Every other `IoError`, such as a timeout, a
// broken pipe or a permission, is `Transport`.  The records read before
// it are discarded rather than answered as a whole file.  A caller who
// wants the prefix of a stream that failed drives `feed` and keeps what
// it handed back.
//
// ```novo
// use reader
// use dialect
//
// fn read_file(path: Str) -> Result<[Row], CsvError> [io, fs]
//     match File.open_read(path)
//         None    => Err(Transport(IoNotFound))
//         Some(f) =>
//             let h: File = f
//             reader.read_all(h, dialect.rfc4180())
//
// fn main() [io, fs]
//     match read_file("people.csv")
//         Ok(rows) => println("${list.len(rows)} record(s)")
//         Err(e)   => println(e.message())
// ```
pub fn read_all<S: Read[e]>(src: S, d: Dialect) -> Result<[Row], CsvError> [e]
    var r = reader(d)
    var rows: [Row] = []
    var transport: ?IoError = None
    var done = false
    loop
        if done
            break
        match src.read(READ_CHUNK)
            Err(e)    =>
                match e
                    IoClosed =>
                        done = true
                    _        =>
                        transport = Some(e)
                        done = true
            Ok(chunk) =>
                if bytes.len(chunk) == 0
                    done = true
                else
                    let (next, got) = feed(r, chunk)
                    r = next
                    rows = list.append(rows, got)
    match transport
        Some(e) => Err(Transport(e))
        None    => Ok(list.append(rows, finish(r)!))

// A whole CSV document already in memory, as records.
//
// `reader` + one `feed_str` + `finish`, for the caller who has the
// text and wants the rows.  It is the shape `std.csv.parse` has, with
// a dialect and an error that names a position.
//
// ```novo
// use reader
// use dialect
//
// fn main() [io]
//     match reader.parse("name,age\nalice,30\n", dialect.rfc4180())
//         Ok(rows) => println("${list.len(rows)}")   // 1 — the header is consumed
//         Err(_)   => println("bad file")
// ```
pub fn parse(text: Str, d: Dialect) -> Result<[Row], CsvError>
    let (r, rows) = feed_str(reader(d), text)
    Ok(list.concat(rows, finish(r)!))
